<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/celeste"
    tools:context=".RequestMoney">

    <TextView
        android:id="@+id/tituloSolicitar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Solicitar dinero"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="100dp" />

    <EditText
        android:id="@+id/persona"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:hint="¿A quién deseas solicitar?"
        android:inputType="textPersonName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloSolicitar"
        android:layout_marginTop="40dp" />

    <EditText
        android:id="@+id/montoSolicitar"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:hint="Monto"
        android:inputType="numberDecimal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/persona"
        android:layout_marginTop="15dp" />

    <EditText
        android:id="@+id/mensajeSolicitud"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:hint="Mensaje (opcional)"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/montoSolicitar"
        android:layout_marginTop="15dp" />

    <Button
        android:id="@+id/btnSolicitar"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:text="Ingresar dinero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mensajeSolicitud"
        android:layout_marginTop="30dp" />
</androidx.constraintlayout.widget.ConstraintLayout>