<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#54BEF8"
    tools:context=".HomeEmpy">

    <View
        android:id="@+id/fondoBlanco"
        android:layout_width="404dp"
        android:layout_height="490dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.55"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/saludoEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola, Daniela"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginTop="80dp" />

    <TextView
        android:id="@+id/textoSaldoEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saldo disponible"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/saludoEmpty"
        app:layout_constraintTop_toBottomOf="@id/saludoEmpty"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/saldoEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$ 0"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@id/textoSaldoEmpty"
        app:layout_constraintTop_toBottomOf="@id/textoSaldoEmpty"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tituloMovimientosEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Últimos movimientos"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/saldoEmpty"
        android:layout_marginStart="30dp"
        android:layout_marginTop="60dp" />

    <TextView
        android:id="@+id/sinMovimientos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aún no tienes movimientos"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloMovimientosEmpty"
        android:layout_marginTop="40dp" />

    <Button
        android:id="@+id/btnEnviarDineroEmpty"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:layout_marginTop="196dp"
        android:text="Enviar dinero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.603"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/saldoEmpty" />

    <Button
        android:id="@+id/btnIngresarDineroEmpty"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:layout_marginTop="72dp"
        android:text="Ingresar dinero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.603"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnEnviarDineroEmpty" />

</androidx.constraintlayout.widget.ConstraintLayout>